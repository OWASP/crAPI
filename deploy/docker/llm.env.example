# crAPI chatbot LLM settings: template.
#
#   cp llm.env.example llm.env.local     # llm.env.local is gitignored (*.local)
#   chmod 600 llm.env.local
#
# Then set one provider below and run ./quickstart.sh from the repo root.
# Docker Compose loads llm.env.local into the crapi-chatbot container (env_file).
# Without it the chatbot still runs, but its LLM features stay off.
#
# Rules: no quotes around values, no `export`, one KEY=value per line.
# Full guide: README.md, "Chatbot LLM Setup".

# Client library: openai (OpenAI and any OpenAI-compatible API) or anthropic
LLM_PROVIDER=openai

# Model id exactly as the provider names it. It must support tool calling.
DEFAULT_MODEL=gpt-4o-mini

# API endpoint. Empty = the provider's default. Set it for OpenAI-compatible providers:
#   xAI         https://api.x.ai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   DeepSeek    https://api.deepseek.com
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://host.docker.internal:11434/v1
LLM_BASE_URL=

# Chat-history embeddings: openai or local. Empty = openai for plain OpenAI, local otherwise.
EMBEDDINGS_PROVIDER=

# The provider's API key
CHATBOT_LLM_API_KEY=

# --- Examples (copy the lines for your provider over the ones above) ---
#
# Anthropic
#   LLM_PROVIDER=anthropic
#   DEFAULT_MODEL=claude-sonnet-5-5
#   LLM_BASE_URL=
#   CHATBOT_LLM_API_KEY=sk-ant-...
#
# xAI (Grok)
#   LLM_PROVIDER=openai
#   DEFAULT_MODEL=grok-4.3
#   LLM_BASE_URL=https://api.x.ai/v1
#   CHATBOT_LLM_API_KEY=xai-...
